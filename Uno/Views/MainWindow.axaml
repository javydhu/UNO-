<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Uno.ViewModels"
        xmlns:models="using:Uno.Models"
        x:Class="Uno.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="root"
        Title="Juego UNO - 3 Jugadores"
        WindowState="Maximized"
        CanResize="False">

	<Window.Resources>
		<vm:BitmapAssetValueConverter x:Key="VariableImageConverter"/>
	</Window.Resources>

	<Grid>
		<!-- Menu Principal -->
		<Grid IsVisible="{Binding !IsGameStarted}">
			<Image Source="avares://Uno/Assets/background1.png" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
			<Button Content="¡ JUGAR !"
			        Command="{Binding StartGame}"
			        Padding="45,18"
			        FontSize="30"
			        FontWeight="Bold"
			        Background="#E74C3C"
			        Foreground="White"
			        CornerRadius="16"
			        HorizontalAlignment="Center"
			        VerticalAlignment="Bottom"
			        Margin="0,0,0,120"
			        Cursor="Hand"/>
		</Grid>

		<!-- Tablero de juego -->
		<Grid IsVisible="{Binding IsGameStarted}" RowDefinitions="Auto, *">
			<Image Grid.RowSpan="2" Source="avares://Uno/Assets/background.png" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>

			<!-- Banner de estado superior -->
			<Border Grid.Row="0" Background="#CC1E1E1E" Padding="12">
				<TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
			</Border>

			<!-- Tablero principal -->
			<Grid Grid.Row="1" ColumnDefinitions="250, *, 250" RowDefinitions="*, Auto">

				<!-- Mano izquierda (90°) -->
				<Border Grid.Column="0" Grid.Row="0" Background="#88000000" Padding="10" Margin="10" CornerRadius="8" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
					<Border.RenderTransform>
						<RotateTransform Angle="90"/>
					</Border.RenderTransform>
					<StackPanel>
						<TextBlock Text="{Binding LeftPlayer.Name, StringFormat='Mano de {0}'}" Foreground="#FFD700" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,5"/>
						<ScrollViewer HorizontalScrollBarVisibility="Hidden" 
						              VerticalScrollBarVisibility="Disabled" 
						              MaxWidth="300"
						              PointerWheelChanged="OnHandPointerWheelChanged">
							<ItemsControl ItemsSource="{Binding LeftPlayer.Hand}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" Spacing="8"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Image Source="{Binding ImagePath, Converter={StaticResource VariableImageConverter}}" Width="65" Height="100"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</StackPanel>
				</Border>

				<!-- Zona Central: Mazo, Pozo e Indicador de Color Activo -->
				<StackPanel Grid.Column="1" Grid.Row="0" Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">

					<!-- Indicador de Color Activo -->
					<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
						<TextBlock Text="COLOR A JUGAR:" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
						<Border Background="{Binding ActiveColorHex}" Width="30" Height="30" CornerRadius="15" BorderBrush="White" BorderThickness="2"/>
					</StackPanel>

					<StackPanel Orientation="Horizontal" Spacing="40" HorizontalAlignment="Center">
						<!-- Mazo -->
						<StackPanel HorizontalAlignment="Center">
							<TextBlock Text=" " Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
							<!-- Agregamos IsVisible y reemplazamos el Border rojo por la Image -->
							<Button Command="{Binding DrawCard}" 
							        Background="Transparent" 
							        Padding="0" 
							        BorderThickness="0" 
							        Cursor="Hand"
							        IsVisible="{Binding HasCardsInDeck}">
                        
								<Image Source="avares://Uno/Assets/Cards/uno.png" Width="100" Height="150"/>
                        
							</Button>
						</StackPanel>

						<!-- Carta en Mesa -->
						<StackPanel HorizontalAlignment="Center">
							<TextBlock Text="Carta en Mesa" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
							<Image Source="{Binding TopCard.ImagePath, Converter={StaticResource VariableImageConverter}}" Width="100" Height="150"/>
						</StackPanel>
					</StackPanel>

					<!-- Botones especiales: Pasar Turno / Tomar Castigo -->
					<StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
						<Button Content="Pasar Turno"
						        Command="{Binding PassTurn}"
						        IsVisible="{Binding CanPassTurn}"
						        Padding="20,10"
						        Background="#7F8C8D"
						        Foreground="White"
						        FontWeight="Bold"
						        CornerRadius="8"
						        Cursor="Hand"/>

						<!-- Cambiamos el Content para que lea la propiedad PenaltyButtonText -->
						<Button Content="{Binding PenaltyButtonText}"
						        Command="{Binding TakePenalty}"
						        IsVisible="{Binding HasPendingDraws}"
						        Padding="20,10"
						        Background="#E74C3C"
						        Foreground="White"
						        FontWeight="Bold"
						        CornerRadius="8"
						        Cursor="Hand"/>
					</StackPanel>
				</StackPanel>

				<!-- Mano derecha (-90°) -->
				<Border Grid.Column="2" Grid.Row="0" Background="#88000000" Padding="10" Margin="10" CornerRadius="8" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
					<Border.RenderTransform>
						<RotateTransform Angle="-90"/>
					</Border.RenderTransform>
					<StackPanel>
						<TextBlock Text="{Binding RightPlayer.Name, StringFormat='Mano de {0}'}" Foreground="#FFD700" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,5"/>
						<ScrollViewer HorizontalScrollBarVisibility="Hidden" 
						              VerticalScrollBarVisibility="Disabled" 
						              MaxWidth="300"
						              PointerWheelChanged="OnHandPointerWheelChanged">
							<ItemsControl ItemsSource="{Binding RightPlayer.Hand}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" Spacing="8"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Image Source="{Binding ImagePath, Converter={StaticResource VariableImageConverter}}" Width="65" Height="100"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</StackPanel>
				</Border>

				<!-- Mano del jugador en turno (ABAJO) -->
				<Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Background="#DD111111" Padding="20, 40" Margin="0,10,0,0">
					<StackPanel HorizontalAlignment="Center">
						<TextBlock Text="{Binding BottomPlayer.Name, StringFormat='TU TURNO: {0}'}" Foreground="#3498DB" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,8"/>
						<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
							<ItemsControl ItemsSource="{Binding BottomPlayer.Hand}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="models:Card">
									
										<Button Command="{Binding OnCardClicked}" 
										        Background="Transparent"
										        Margin="0, 15"
										        Padding="0" 
										        BorderThickness="0" 
										        Cursor="Hand"
										        Classes.playable="{Binding IsPlayable}"
										        RenderTransformOrigin="50%,50%">
         
											<Button.Styles>
												<!-- Estado normal de todas las cartas -->
												<Style Selector="Button">
													<Setter Property="RenderTransform" Value="scale(1.0)"/>
													<Setter Property="ZIndex" Value="0"/>
													<Setter Property="Transitions">
														<Transitions>
															<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
														</Transitions>
													</Setter>
												</Style>
            
												<!-- Estado Hover SÓLO cuando la carta tiene la clase 'playable' -->
												<Style Selector="Button.playable:pointerover">
													<Setter Property="RenderTransform" Value="scale(1.1)"/>
													<Setter Property="ZIndex" Value="1"/> <!-- La pone por encima de las demás cartas -->
												</Style>
											</Button.Styles>

											<Image Source="{Binding ImagePath, Converter={StaticResource VariableImageConverter}}" Width="100" Height="140"/>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</StackPanel>
				</Border>
			</Grid>
		</Grid>

		<!-- Modal de selección de colores -->
		<Grid IsVisible="{Binding IsColorPickerVisible}"
		      Background="#AA000000"
		      IsHitTestVisible="True"
		      HorizontalAlignment="Stretch"
		      VerticalAlignment="Stretch">

			<Border Background="#2D2D30"
			        CornerRadius="16"
			        Padding="30"
			        HorizontalAlignment="Center"
			        VerticalAlignment="Center"
			        BorderBrush="White"
			        BorderThickness="2"
			        IsHitTestVisible="True">

				<StackPanel Spacing="20" HorizontalAlignment="Center">
					<TextBlock Text="¡ELIGE UN COLOR!" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>

					<WrapPanel Width="280" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center">
						<Button Command="{Binding SelectColor}" CommandParameter="Red"
						        Width="120" Height="120" Margin="10"
						        Background="#E74C3C" Foreground="White"
						        FontSize="18" FontWeight="Bold"
						        Content="ROJO" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
						        CornerRadius="12" Cursor="Hand" IsHitTestVisible="True"/>

						<Button Command="{Binding SelectColor}" CommandParameter="Yellow"
						        Width="120" Height="120" Margin="10"
						        Background="#F1C40F" Foreground="Black"
						        FontSize="18" FontWeight="Bold"
						        Content="AMARILLO" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
						        CornerRadius="12" Cursor="Hand" IsHitTestVisible="True"/>

						<Button Command="{Binding SelectColor}" CommandParameter="Blue"
						        Width="120" Height="120" Margin="10"
						        Background="#3498DB" Foreground="White"
						        FontSize="18" FontWeight="Bold"
						        Content="AZUL" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
						        CornerRadius="12" Cursor="Hand" IsHitTestVisible="True"/>

						<Button Command="{Binding SelectColor}" CommandParameter="Green"
						        Width="120" Height="120" Margin="10"
						        Background="#2ECC71" Foreground="White"
						        FontSize="18" FontWeight="Bold"
						        Content="VERDE" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
						        CornerRadius="12" Cursor="Hand" IsHitTestVisible="True"/>
					</WrapPanel>
				</StackPanel>
			</Border>
		</Grid>

		<!-- Pantalla de victoria y puntos -->
		<Grid IsVisible="{Binding IsGameOver}" Background="#CC000000">
			<Border Background="#1E1E1E" CornerRadius="20" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#FFD700" BorderThickness="3">
				<StackPanel Spacing="20" HorizontalAlignment="Center">
					<TextBlock Text="¡JUEGO FINALIZADO!" Foreground="#FFD700" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
					<TextBlock Text="{Binding WinnerName, StringFormat='¡GANADOR: {0}!'}" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
					<TextBlock Text="{Binding GameOverDetails}" Foreground="#CCCCCC" FontSize="18" HorizontalAlignment="Center" TextAlignment="Center"/>

					<Button Content="Nueva Partida"
					        Command="{Binding StartGame}"
					        Padding="30,12"
					        FontSize="20"
					        FontWeight="Bold"
					        Background="#2ECC71"
					        Foreground="White"
					        CornerRadius="10"
					        HorizontalAlignment="Center"
					        Cursor="Hand"/>
				</StackPanel>
			</Border>
		</Grid>

	</Grid>
</Window>