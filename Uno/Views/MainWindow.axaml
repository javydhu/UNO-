<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Uno.ViewModels"
        x:Class="Uno.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="root"
        Title="Juego UNO - 3 Jugadores"
        WindowState="Maximized"
        CanResize="False">

	<Window.Resources>
		<vm:BitmapAssetValueConverter x:Key="VariableImageConverter"/>
	</Window.Resources>

	<Grid>
		<!-- VISTA 1: MENÚ PRINCIPAL (Fondo background1.png) -->
		<Grid IsVisible="{Binding !IsGameStarted}">
			<Image Source="avares://Uno/Assets/background1.png" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>

			<Button Content="¡ JUGAR !"
			        Command="{Binding StartGame}"
			        Padding="45,20"
			        FontSize="32"
			        FontWeight="Bold"
			        Background="#E74C3C"
			        Foreground="White"
			        CornerRadius="16"
			        HorizontalAlignment="Center"
			        VerticalAlignment="Center"
			        Cursor="Hand"/>
		</Grid>

		<!-- VISTA 2: TABLERO DE JUEGO (Fondo background.jpg) -->
		<Grid IsVisible="{Binding IsGameStarted}" RowDefinitions="Auto, *, Auto, Auto">
			<Image Grid.RowSpan="4" Source="avares://Uno/Assets/background.jpg" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>

			<!-- Banner de Estado Superior -->
			<Border Grid.Row="0" Background="#CC1E1E1E" Padding="12">
				<TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
			</Border>

			<!-- MANO JUGADOR 2 (Arriba) -->
			<Border Grid.Row="1" Background="#88000000" Padding="10" Margin="20,5" CornerRadius="8">
				<StackPanel>
					<TextBlock Text="{Binding Game.Players[1].Name, StringFormat='Mano de {0}'}" Foreground="#FFD700" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,5"/>
					<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
						<ItemsControl ItemsSource="{Binding Game.Players[1].Hand}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Button Command="{Binding #root.DataContext.PlayCard}" CommandParameter="{Binding}" Background="Transparent" Padding="0" BorderThickness="0" Cursor="Hand">
										<Image Source="{Binding ImagePath, Converter={StaticResource VariableImageConverter}}" Width="70" Height="105"/>
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</StackPanel>
			</Border>

			<!-- ZONA CENTRAL: Mazo, Pozo y MANO JUGADOR 3 -->
			<Grid Grid.Row="2" ColumnDefinitions="*, Auto, *" Margin="20,0">
				<!-- Mazo y Carta Activa -->
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="40" HorizontalAlignment="Center" VerticalAlignment="Center">
					<!-- Mazo -->
					<StackPanel HorizontalAlignment="Center">
						<TextBlock Text="Mazo" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
						<Button Command="{Binding DrawCard}" Background="Transparent" Padding="0" BorderThickness="0" Cursor="Hand">
							<Border CornerRadius="8" ClipToBounds="True" Background="#C0392B" Width="90" Height="135" BorderBrush="White" BorderThickness="2">
								<TextBlock Text="UNO" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
						</Button>
					</StackPanel>

					<!-- Carta en Mesa -->
					<StackPanel HorizontalAlignment="Center">
						<TextBlock Text="Carta en Mesa" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
						<Image Source="{Binding Game.TopCard.ImagePath, Converter={StaticResource VariableImageConverter}}" Width="90" Height="135"/>
					</StackPanel>
				</StackPanel>

				<!-- MANO JUGADOR 3 (Lado Derecho del Centro) -->
				<Border Grid.Column="2" Background="#88000000" Padding="10" Margin="20,0,0,0" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Center">
					<StackPanel>
						<TextBlock Text="{Binding Game.Players[2].Name, StringFormat='Mano de {0}'}" Foreground="#FFD700" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,5"/>
						<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="350">
							<ItemsControl ItemsSource="{Binding Game.Players[2].Hand}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" Spacing="8"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Button Command="{Binding #root.DataContext.PlayCard}" CommandParameter="{Binding}" Background="Transparent" Padding="0" BorderThickness="0" Cursor="Hand">
											<Image Source="{Binding ImagePath, Converter={StaticResource VariableImageConverter}}" Width="70" Height="105"/>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</StackPanel>
				</Border>
			</Grid>

			<!-- MANO JUGADOR 1 (Abajo) -->
			<Border Grid.Row="3" Background="#DD111111" Padding="12" Margin="0,10,0,0">
				<StackPanel>
					<TextBlock Text="{Binding Game.Players[0].Name, StringFormat='Mano de {0}'}" Foreground="#3498DB" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,5"/>
					<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
						<ItemsControl ItemsSource="{Binding Game.Players[0].Hand}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Button Command="{Binding #root.DataContext.PlayCard}" CommandParameter="{Binding}" Background="Transparent" Padding="0" BorderThickness="0" Cursor="Hand">
										<Image Source="{Binding ImagePath, Converter={StaticResource VariableImageConverter}}" Width="85" Height="130"/>
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</Window>