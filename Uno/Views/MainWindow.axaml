<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Uno.ViewModels"
        xmlns:models="using:Uno.Shared.Models"
        x:Class="Uno.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="root"
        Title="UNO - Multijugador"
        WindowState="Maximized"
        CanResize="False">

	<Window.Resources>
		<vm:BitmapAssetValueConverter x:Key="VariableImageConverter"/>
	</Window.Resources>

	<Grid>
		<!-- ================================= -->
<!-- PANTALLA DE CONEXIÓN -->
<!-- ================================= -->

<Grid IsVisible="{Binding IsConnectionScreenVisible}">

    <Image Source="avares://Uno/Assets/background1.png"
           Stretch="UniformToFill"/>

    <Border Background="#DD1E1E1E"
            CornerRadius="20"
            Padding="45"
            Width="480"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

        <StackPanel Spacing="18">

            <TextBlock Text="UNO"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="#FFD700"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Conectarse al servidor"
                       Foreground="White"
                       FontSize="22"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Dirección IP"
                       Foreground="White"
                       FontWeight="Bold"/>

            <TextBox Text="{Binding ServerIp}"
                     Watermark="Ej. 192.168.1.45"
                     FontSize="18"
                     Padding="12"/>

            <TextBlock Text="Puerto"
                       Foreground="White"
                       FontWeight="Bold"/>

            <TextBox Text="{Binding ServerPort}"
                     Watermark="5000"
                     FontSize="18"
                     Padding="12"/>

            <Button Content="CONECTAR"
                    Command="{Binding ConnectCommand}"
                    Padding="20"
                    Background="#27AE60"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="20"
                    CornerRadius="10"
                    Cursor="Hand"/>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#F1C40F"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

        </StackPanel>
    </Border>
</Grid>
		
		<!-- ================================= -->
<!-- SELECCIÓN DE JUGADOR -->
<!-- ================================= -->

<Grid IsVisible="{Binding IsPlayerSelectionVisible}">

    <Image Source="avares://Uno/Assets/background1.png"
           Stretch="UniformToFill"/>

    <Border Background="#DD1E1E1E"
            CornerRadius="20"
            Padding="40"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

        <StackPanel Spacing="18">

            <TextBlock Text="SELECCIONAR JUGADOR"
                       Foreground="#FFD700"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Jugadores registrados:"
                       Foreground="White"
                       FontSize="16"/>

            <ComboBox ItemsSource="{Binding RegisteredPlayers}"
                      SelectedItem="{Binding SelectedRegisteredPlayer}"
                      HorizontalAlignment="Stretch"
                      FontSize="17"
                      PlaceholderText="Selecciona un jugador">

                <ComboBox.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                        <TextBlock Text="{Binding Nombre}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>

            </ComboBox>

            <Button Content="UTILIZAR JUGADOR"
                    Command="{Binding JoinSelectedPlayerCommand}"
                    Background="#3498DB"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="15"
                    CornerRadius="8"
                    Cursor="Hand"/>

            <Border Height="1"
                    Background="#888888"
                    Margin="0,10"/>

            <TextBlock Text="¿Eres un jugador nuevo?"
                       Foreground="White"
                       FontWeight="Bold"/>

            <TextBox Text="{Binding NewPlayerName}"
                     Watermark="Escribe tu nombre"
                     FontSize="17"
                     Padding="12"/>

            <Button Content="REGISTRAR Y ENTRAR"
                    Command="{Binding RegisterNewPlayerCommand}"
                    Background="#27AE60"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="15"
                    CornerRadius="8"
                    Cursor="Hand"/>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#F1C40F"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

        </StackPanel>
    </Border>
</Grid>
		
		<!-- ================================= -->
<!-- SALA DE ESPERA -->
<!-- ================================= -->

<Grid IsVisible="{Binding IsWaitingRoomVisible}">

    <Image Source="avares://Uno/Assets/background1.png"
           Stretch="UniformToFill"/>

    <Border Background="#DD1E1E1E"
            CornerRadius="20"
            Padding="40"
            Width="550"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

        <StackPanel Spacing="20">

            <TextBlock Text="SALA DE ESPERA"
                       Foreground="#FFD700"
                       FontSize="30"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding WaitingRoomCountText}"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <Border Height="1"
                    Background="#888888"/>

            <TextBlock Text="Jugadores conectados:"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"/>

            <ItemsControl ItemsSource="{Binding WaitingRoomPlayers}">

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">

                        <Border Background="#333333"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,5">

                            <StackPanel Orientation="Horizontal"
                                        Spacing="12">

                                <TextBlock Text="●"
                                           Foreground="#2ECC71"
                                           FontSize="20"/>

                                <TextBlock Text="{Binding Name}"
                                           Foreground="White"
                                           FontSize="18"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <TextBlock Text="Esperando a que se conecten los demás jugadores..."
                       Foreground="#F1C40F"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="15"/>

            <Button Content="CANCELAR Y SALIR"
                    Command="{Binding CancelWaitingCommand}"
                    Background="#E74C3C"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="15"
                    CornerRadius="8"
                    Cursor="Hand"/>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="White"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

        </StackPanel>
    </Border>
</Grid>

		<!-- Tablero de juego -->
		<Grid IsVisible="{Binding IsGameStarted}" RowDefinitions="Auto, *">
			<Image Grid.RowSpan="2" Source="avares://Uno/Assets/background.png" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>

			<!-- Contenedor superior para el Banner y el Botón de Opciones -->
			<Grid Grid.Row="0">
				<!-- Banner de estado superior (Centrado) -->
				<Border Background="#CC1E1E1E" Padding="12">
					<TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
				</Border>

				<!-- Botón de opciones -->
				<Button Command="{Binding TogglePauseMenuCommand}"
				        Background="Transparent"
				        Padding="15,10"
				        HorizontalAlignment="Left"
				        VerticalAlignment="Center"
				        Cursor="Hand"
				        BorderThickness="0">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<!-- Icono de hamburguesa básico con caracteres Unicode -->
						<TextBlock Text="☰" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
						<TextBlock Text="OPCIONES" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</Grid>

			<!-- Tablero principal -->
			<Grid Grid.Row="1" ColumnDefinitions="250, *, 250" RowDefinitions="*, Auto">

				<!-- Rival izquierdo: únicamente información pública -->
				<Border Grid.Column="0" Grid.Row="0" Background="#88000000" Padding="10" Margin="10" CornerRadius="8" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
					<Border.RenderTransform>
						<RotateTransform Angle="90"/>
					</Border.RenderTransform>
					<StackPanel Spacing="12">

						<TextBlock Text="{Binding LeftPlayer.Name, StringFormat='Jugador: {0}'}"
						           Foreground="#FFD700"
						           FontWeight="Bold"
						           FontSize="18"
						           HorizontalAlignment="Center"/>

						<TextBlock Text="{Binding LeftPlayer.HandCount, StringFormat='Cartas: {0}'}"
						           Foreground="White"
						           FontSize="16"
						           HorizontalAlignment="Center"/>

					</StackPanel>
				</Border>

				<!-- Zona Central: Mazo, Pozo e Indicador de Color Activo -->
				<StackPanel Grid.Column="1" Grid.Row="0" Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">

					<!-- Indicador de Color Activo -->
					<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
						<TextBlock Text="COLOR A JUGAR:" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
						<Border Background="{Binding ActiveColorHex}" Width="30" Height="30" CornerRadius="15" BorderBrush="White" BorderThickness="2"/>
					</StackPanel>

					<StackPanel Orientation="Horizontal" Spacing="40" HorizontalAlignment="Center">
						<!-- Mazo -->
						<StackPanel HorizontalAlignment="Center">
							<TextBlock Text=" " Foreground="Transparent" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
							<Button Command="{Binding DrawCardCommand}" 
							        Background="Transparent" 
							        Padding="0" 
							        BorderThickness="0" 
							        Cursor="Hand"
							        IsVisible="{Binding HasCardsInDeck}">
                        
								<Image Source="avares://Uno/Assets/Cards/uno.png" Width="100" Height="150"/>
                        
							</Button>
						</StackPanel>

						<!-- Carta en Mesa -->
						<StackPanel HorizontalAlignment="Center">
							<TextBlock Text="Carta en Mesa" Foreground="Transparent" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
							<Image Source="{Binding TopCard.ImagePath, Converter={StaticResource VariableImageConverter}}" Width="100" Height="150"/>
						</StackPanel>
					</StackPanel>

					<!-- Botones especiales: Pasar Turno / Tomar Castigo -->
					<StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
                        
						<!-- DECIR UNO -->
						<Button Content="¡ UNO !"
						        Command="{Binding ShoutUnoCommand}"
						        IsVisible="{Binding CanShoutUno}"
						        Padding="30,10"
						        Background="#F39C12"
						        Foreground="White"
						        FontWeight="Bold"
						        CornerRadius="8"
						        Cursor="Hand"/>

						<Button Content="Pasar Turno"
						        Command="{Binding PassTurnCommand}"
						        IsVisible="{Binding CanPassTurn}"
						        Padding="20,10"
						        Background="#7F8C8D"
						        Foreground="White"
						        FontWeight="Bold"
						        CornerRadius="8"
						        Cursor="Hand"/>

						<Button Content="{Binding PenaltyButtonText}"
						        Command="{Binding TakePenaltyCommand}"
						        IsVisible="{Binding HasPendingDraws}"
						        Padding="20,10"
						        Background="#E74C3C"
						        Foreground="White"
						        FontWeight="Bold"
						        CornerRadius="8"
						        Cursor="Hand"/>
					</StackPanel>
				</StackPanel>

				<!-- Rival derecho: únicamente información pública -->
				<Border Grid.Column="2" Grid.Row="0" Background="#88000000" Padding="10" Margin="10" CornerRadius="8" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
					<Border.RenderTransform>
						<RotateTransform Angle="-90"/>
					</Border.RenderTransform>
					<StackPanel Spacing="12">

						<TextBlock Text="{Binding RightPlayer.Name, StringFormat='Jugador: {0}'}"
						           Foreground="#FFD700"
						           FontWeight="Bold"
						           FontSize="18"
						           HorizontalAlignment="Center"/>

						<TextBlock Text="{Binding RightPlayer.HandCount, StringFormat='Cartas: {0}'}"
						           Foreground="White"
						           FontSize="16"
						           HorizontalAlignment="Center"/>

					</StackPanel>
				</Border>

				<!-- Mano privada del jugador local (ABAJO) -->
				<Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Background="#DD111111" Padding="20, 40" Margin="0,10,0,0">
					<StackPanel HorizontalAlignment="Center">
						<TextBlock Text="{Binding BottomPlayerLabel}" Foreground="#3498DB" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,8"/>
						<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
							<ItemsControl ItemsSource="{Binding BottomPlayer.Hand}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="models:Card" x:DataType="models:Card">
									
										<Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PlayCardCommand}"
										        CommandParameter="{Binding}" 
										        Background="Transparent"
										        Margin="0, 15"
										        Padding="0" 
										        BorderThickness="0" 
										        Cursor="Hand"
										        Classes.playable="{Binding IsPlayable}"
										        RenderTransformOrigin="50%,50%">
         
											<Button.Styles>
												<!-- Estado normal de todas las cartas -->
												<Style Selector="Button">
													<Setter Property="RenderTransform" Value="scale(1.0)"/>
													<Setter Property="ZIndex" Value="0"/>
													<Setter Property="Transitions">
														<Transitions>
															<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
														</Transitions>
													</Setter>
												</Style>
            
												<!-- Estado Hover SÓLO cuando la carta tiene la clase 'playable' -->
												<Style Selector="Button.playable:pointerover">
													<Setter Property="RenderTransform" Value="scale(1.1)"/>
													<Setter Property="ZIndex" Value="1"/> <!-- La pone por encima de las demás cartas -->
												</Style>
											</Button.Styles>

											<Image Source="{Binding ImagePath, Converter={StaticResource VariableImageConverter}}" Width="100" Height="140"/>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</StackPanel>
				</Border>
			</Grid>
		</Grid>

		<!-- Modal de selección de colores -->
		<Grid IsVisible="{Binding IsColorPickerVisible}"
		      Background="#AA000000"
		      IsHitTestVisible="True"
		      HorizontalAlignment="Stretch"
		      VerticalAlignment="Stretch">

			<Border Background="#2D2D30"
			        CornerRadius="16"
			        Padding="30"
			        HorizontalAlignment="Center"
			        VerticalAlignment="Center"
			        BorderBrush="White"
			        BorderThickness="2"
			        IsHitTestVisible="True">

				<StackPanel Spacing="20" HorizontalAlignment="Center">
					<TextBlock Text="¡ELIGE UN COLOR!" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>

					<WrapPanel Width="280" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center">
						<Button Command="{Binding SelectColorCommand}" CommandParameter="Red"
						        Width="120" Height="120" Margin="10"
						        Background="#E74C3C" Foreground="White"
						        FontSize="18" FontWeight="Bold"
						        Content="ROJO" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
						        CornerRadius="12" Cursor="Hand" IsHitTestVisible="True"/>

						<Button Command="{Binding SelectColorCommand}" CommandParameter="Yellow"
						        Width="120" Height="120" Margin="10"
						        Background="#F1C40F" Foreground="Black"
						        FontSize="18" FontWeight="Bold"
						        Content="AMARILLO" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
						        CornerRadius="12" Cursor="Hand" IsHitTestVisible="True"/>

						<Button Command="{Binding SelectColorCommand}" CommandParameter="Blue"
						        Width="120" Height="120" Margin="10"
						        Background="#3498DB" Foreground="White"
						        FontSize="18" FontWeight="Bold"
						        Content="AZUL" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
						        CornerRadius="12" Cursor="Hand" IsHitTestVisible="True"/>

						<Button Command="{Binding SelectColorCommand}" CommandParameter="Green"
						        Width="120" Height="120" Margin="10"
						        Background="#2ECC71" Foreground="White"
						        FontSize="18" FontWeight="Bold"
						        Content="VERDE" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
						        CornerRadius="12" Cursor="Hand" IsHitTestVisible="True"/>
					</WrapPanel>
				</StackPanel>
			</Border>
		</Grid>

		<!-- Pantalla de victoria y puntos -->
		<Grid IsVisible="{Binding IsGameOver}" Background="#CC000000">
			<Border Background="#1E1E1E" CornerRadius="20" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#FFD700" BorderThickness="3">
				<StackPanel Spacing="20" HorizontalAlignment="Center">
					<TextBlock Text="¡JUEGO FINALIZADO!" Foreground="#FFD700" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
					<TextBlock Text="{Binding WinnerName, StringFormat='¡GANADOR: {0}!'}" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
					<TextBlock Text="{Binding GameOverDetails}" Foreground="#CCCCCC" FontSize="18" HorizontalAlignment="Center" TextAlignment="Center"/>

					<Button Content="VOLVER AL INICIO"
					        Command="{Binding ExitToMenuCommand}"
					        Padding="30,12"
					        FontSize="20"
					        FontWeight="Bold"
					        Background="#2ECC71"
					        Foreground="White"
					        CornerRadius="10"
					        HorizontalAlignment="Center"
					        Cursor="Hand"/>
				</StackPanel>
			</Border>
		</Grid>

	<Grid IsVisible="{Binding IsPauseMenuVisible}"
              Background="#AA000000"
              IsHitTestVisible="True"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <Border Background="#2D2D30"
                    CornerRadius="16"
                    Padding="40,30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="White"
                    BorderThickness="2">

                <StackPanel Spacing="25" HorizontalAlignment="Center" Width="250">
                    <TextBlock Text="MENÚ DE OPCIONES" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>

                    <Button Content="Reanudar Partida"
                            Command="{Binding TogglePauseMenuCommand}"
                            Padding="15"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="#3498DB"
                            Foreground="White"
                            CornerRadius="8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Cursor="Hand"/>

                    <Button Content="Salir al inicio"
                            Command="{Binding ExitToMenuCommand}"
                            Padding="15"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="#E74C3C"
                            Foreground="White"
                            CornerRadius="8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>