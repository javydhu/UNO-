<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Uno.ViewModels"
        x:Class="Uno.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Juego UNO - 3 Jugadores"
        Width="900" Height="650"
        WindowStartupLocation="CenterScreen">

	<Grid RowDefinitions="Auto, *, Auto" Background="#1E1E1E">
		<!-- Panel de Estado Superior -->
		<Border Grid.Row="0" Background="#2D2D30" Padding="15" HorizontalAlignment="Stretch">
			<TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
		</Border>

		<!-- Área Central: Carta en Mesa y Mazo para Robar -->
		<Grid Grid.Row="1" ColumnDefinitions="*, *" HorizontalAlignment="Center" VerticalAlignment="Center">
			<!-- Mazo de Robar -->
			<StackPanel Grid.Column="0" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
				<TextBlock Text="Mazo" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,10"/>
				<Button Command="{Binding DrawCard}" Background="Transparent" Padding="0" BorderThickness="0">
					<Border CornerRadius="8" ClipToBounds="True" Background="#B22222" Width="100" Height="150">
						<TextBlock Text="UNO" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
				</Button>
			</StackPanel>

			<!-- Carta Superior del Pozo -->
			<StackPanel Grid.Column="1" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
				<TextBlock Text="Carta en Mesa" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,10"/>
				<Image Source="{Binding Game.TopCard.ImagePath}" Width="100" Height="150"/>
			</StackPanel>
		</Grid>

		<!-- Mano del Jugador Actual (Abajo) -->
		<Border Grid.Row="2" Background="#252526" Padding="15">
			<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
				<ItemsControl ItemsSource="{Binding Game.CurrentPlayer.Hand}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" Spacing="10"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PlayCard}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" Padding="0" BorderThickness="0">
								<Image Source="{Binding ImagePath}" Width="90" Height="135"/>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Border>
	</Grid>
</Window>