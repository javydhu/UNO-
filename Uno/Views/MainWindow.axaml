<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Uno.ViewModels"
        x:Class="Uno.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="root"
        Title="Juego UNO - 3 Jugadores"
        WindowState="Maximized"
        CanResize="False">

	<Window.Resources>
		<vm:BitmapAssetValueConverter x:Key="VariableImageConverter"/>
	</Window.Resources>

	<Grid>
		<!-- Menu principal -->
		<Grid IsVisible="{Binding !IsGameStarted}">
			<Image Source="avares://Uno/Assets/background1.png" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>

			<!-- Boton de "jugar" -->
			<Button Content="¡ JUGAR !"
			        Command="{Binding StartGame}"
			        Padding="45,18"
			        FontSize="30"
			        FontWeight="Bold"
			        Background="#E74C3C"
			        Foreground="White"
			        CornerRadius="16"
			        HorizontalAlignment="Center"
			        VerticalAlignment="Bottom"
			        Margin="0,0,0,120"
			        Cursor="Hand"/>
		</Grid>

		<!-- Menu de juego -->
		<Grid IsVisible="{Binding IsGameStarted}" RowDefinitions="Auto, *">
			<Image Grid.RowSpan="2" Source="avares://Uno/Assets/background.jpg" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>

			<!-- Banner de estado superior -->
			<Border Grid.Row="0" Background="#CC1E1E1E" Padding="12">
				<TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
			</Border>

			<!-- Tablero principal -->
			<Grid Grid.Row="1" ColumnDefinitions="250, *, 250" RowDefinitions="*, Auto">

				<!-- Mano del jugador izquierdo -->
				<Border Grid.Column="0" Grid.Row="0" Background="#88000000" Padding="10" Margin="10" CornerRadius="8" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
					<Border.RenderTransform>
						<RotateTransform Angle="90"/>
					</Border.RenderTransform>
					<StackPanel>
						<TextBlock Text="{Binding LeftPlayer.Name, StringFormat='Mano de {0}'}" Foreground="#FFD700" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,5"/>
						<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="300">
							<ItemsControl ItemsSource="{Binding LeftPlayer.Hand}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" Spacing="8"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Image Source="{Binding ImagePath, Converter={StaticResource VariableImageConverter}}" Width="65" Height="100"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</StackPanel>
				</Border>

				<!-- Mazo de comida y del juego -->
				<StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Spacing="40" HorizontalAlignment="Center" VerticalAlignment="Center">
					<!-- Mazo -->
					<StackPanel HorizontalAlignment="Center">
						<TextBlock Text="Mazo" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
						<Button Command="{Binding DrawCard}" Background="Transparent" Padding="0" BorderThickness="0" Cursor="Hand">
							<Border CornerRadius="10" ClipToBounds="True" Background="#C0392B" Width="100" Height="150" BorderBrush="White" BorderThickness="2">
								<TextBlock Text="UNO" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
						</Button>
					</StackPanel>

					<!-- Carta en mesa -->
					<StackPanel HorizontalAlignment="Center">
						<TextBlock Text="Carta en Mesa" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
						<Image Source="{Binding Game.TopCard.ImagePath, Converter={StaticResource VariableImageConverter}}" Width="100" Height="150"/>
					</StackPanel>
				</StackPanel>

				<!-- Mano del jugador derecho (GIRADA -90°) -->
				<Border Grid.Column="2" Grid.Row="0" Background="#88000000" Padding="10" Margin="10" CornerRadius="8" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
					<Border.RenderTransform>
						<RotateTransform Angle="-90"/>
					</Border.RenderTransform>
					<StackPanel>
						<TextBlock Text="{Binding RightPlayer.Name, StringFormat='Mano de {0}'}" Foreground="#FFD700" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,5"/>
						<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="300">
							<ItemsControl ItemsSource="{Binding RightPlayer.Hand}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" Spacing="8"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Image Source="{Binding ImagePath, Converter={StaticResource VariableImageConverter}}" Width="65" Height="100"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</StackPanel>
				</Border>

				<!-- Mano del jugador actual -->
				<Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Background="#DD111111" Padding="15" Margin="0,10,0,0">
					<StackPanel HorizontalAlignment="Center">
						<TextBlock Text="{Binding BottomPlayer.Name, StringFormat='TU TURNO: {0}'}" Foreground="#3498DB" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,8"/>
						<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
							<ItemsControl ItemsSource="{Binding BottomPlayer.Hand}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Button Command="{Binding #root.DataContext.PlayCard}" CommandParameter="{Binding}" Background="Transparent" Padding="0" BorderThickness="0" Cursor="Hand">
											<Image Source="{Binding ImagePath, Converter={StaticResource VariableImageConverter}}" Width="95" Height="140"/>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</StackPanel>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</Window>