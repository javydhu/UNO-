<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Uno.App"
             xmlns:local="using:Uno"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        
        <Style Selector="TextBlock.titulo">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="TextBlock.subtitulo">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#B8C0CC"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.etiqueta">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFD60A"/>
        </Style>
        <Style Selector="TextBlock.ayuda">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9AA3B2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFB4B4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ===================== PANELES ===================== -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#EB141821"/>
            <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="BoxShadow" Value="0 24 60 0 #80000000"/>
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="CornerRadius" Value="100"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>
        <Style Selector="Border.callout">
            <Setter Property="Background" Value="#33EF4444"/>
            <Setter Property="BorderBrush" Value="#99EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <!-- Banner superior de estado: verde en tu turno, rojo si hay castigo acumulado -->
        <Style Selector="Border.banner">
            <Setter Property="Background" Value="#E6141821"/>
            <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="Border.banner.mine">
            <Setter Property="Background" Value="#F0156B38"/>
            <Setter Property="BorderBrush" Value="#FFD60A"/>
        </Style>
        <Style Selector="Border.banner.alert">
            <Setter Property="Background" Value="#F0A31224"/>
            <Setter Property="BorderBrush" Value="#FFD60A"/>
        </Style>

        <!-- Aro que parpadea alrededor del jugador al que le toca -->
        <Style Selector="Border.turnRing">
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ===================== BOTONES ===================== -->
        <Style Selector="Button.btn">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,13"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.btn:disabled">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>

        <Style Selector="Button.cta">
            <Setter Property="Background" Value="#D90F2B"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.cta:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0233F"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.cta:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#B30B22"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.ok">
            <Setter Property="Background" Value="#15803D"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.ok:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#189443"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.ok:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#116A33"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.warn">
            <Setter Property="Background" Value="#FFD60A"/>
            <Setter Property="Foreground" Value="#14161C"/>
        </Style>
        <Style Selector="Button.warn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFE24D"/>
            <Setter Property="Foreground" Value="#14161C"/>
        </Style>
        <Style Selector="Button.warn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E6BF00"/>
            <Setter Property="Foreground" Value="#14161C"/>
        </Style>

        <Style Selector="Button.info">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.info:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3B76F0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.info:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1D4FC4"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.muted">
            <Setter Property="Background" Value="#3A4252"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.muted:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4A5468"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.muted:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2E3543"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Muestras de color del jugador -->
        <Style Selector="Button.swatch">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="CornerRadius" Value="100"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="scale(1.0)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.swatch:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.12)"/>
        </Style>
        <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#80FFFFFF"/>
        </Style>
        <Style Selector="Button.swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.swatch.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="White"/>
        </Style>
        <Style Selector="Button.swatch.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="White"/>
        </Style>

        <!-- Cartas y mazo: botones transparentes que se levantan -->
        <Style Selector="Button.carta">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="50%,100%"/>
            <Setter Property="RenderTransform" Value="translateY(0px) scale(1.0)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.carta:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.carta:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.cara">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BoxShadow" Value="0 6 16 0 #80000000"/>
        </Style>
        <!-- Carta jugable: ya viene un poco arriba y con aro amarillo; al pasar el mouse sube mas -->
        <Style Selector="Button.carta.playable">
            <Setter Property="RenderTransform" Value="translateY(-14px) scale(1.0)"/>
        </Style>
        <Style Selector="Button.carta.playable:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-26px) scale(1.07)"/>
        </Style>
        <Style Selector="Button.carta.playable Border.cara">
            <Setter Property="BorderBrush" Value="#FFD60A"/>
            <Setter Property="BoxShadow" Value="0 10 24 0 #99FFD60A"/>
        </Style>
        <!-- En tu turno, las cartas que NO se pueden jugar se apagan -->
        <Style Selector="Border.miMano.turno Button.carta:not(.playable) Border.cara">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Button.mazo.turno">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.mazo">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style Selector="Button.mazo.turno:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-8px) scale(1.04)"/>
        </Style>

        <!-- Fichas de color del modal de comodin -->
        <Style Selector="Button.ficha">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="scale(1.0)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ficha:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.07)"/>
        </Style>
        <Style Selector="Button.ficha:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.ficha:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ===================== CAMPOS DE TEXTO ===================== -->
        <Style Selector="TextBox.campo">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#0F131B"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.campo:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#151A25"/>
            <Setter Property="BorderBrush" Value="#80FFFFFF"/>
        </Style>
        <Style Selector="TextBox.campo:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#0F131B"/>
            <Setter Property="BorderBrush" Value="#FFD60A"/>
        </Style>
    </Application.Styles>
</Application>
